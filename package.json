{
  "name": "yunyu-renju-classroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:book": "node scripts/verify-book.mjs && node scripts/verify-g8.mjs && node scripts/verify-f10.mjs",
    "expand:f10": "node scripts/expand-f10.mjs",
    "add:f10": "node scripts/expand-f10.mjs --requested-only",
    "compact:book": "node scripts/compact-g8.mjs",
    "build:g8": "node scripts/build-g8.mjs",
    "deploy:api": "wrangler deploy",
    "dev:worker": "wrangler dev"
  },
  "devDependencies": { "wrangler": "^4.0.0" },
  "engines": { "node": ">=22" }
}
