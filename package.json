{
  "name": "yunyu-renju-classroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:book": "node scripts/verify-book.mjs && node scripts/verify-g8.mjs && node scripts/verify-tempo-fours.mjs && node scripts/verify-double-four-three.mjs && node scripts/verify-f10.mjs && node scripts/verify-f11.mjs && node scripts/verify-h9.mjs",
    "expand:f10": "node scripts/expand-f10.mjs && node scripts/prune-tempo-fours.mjs",
    "expand:f11": "node scripts/expand-f10.mjs --branch=F11 && node scripts/prune-tempo-fours.mjs",
    "expand:h9": "node scripts/expand-f10.mjs --branch=H9 && node scripts/prune-tempo-fours.mjs",
    "add:f10": "node scripts/expand-f10.mjs --requested-only && node scripts/prune-tempo-fours.mjs",
    "prune:book": "node scripts/prune-tempo-fours.mjs",
    "complete:sides": "node scripts/augment-double-four-three.mjs",
    "compact:book": "node scripts/compact-g8.mjs",
    "build:g8": "node scripts/build-g8.mjs && node scripts/prune-tempo-fours.mjs",
    "deploy:api": "wrangler deploy",
    "dev:worker": "wrangler dev"
  },
  "devDependencies": { "wrangler": "^4.0.0" },
  "engines": { "node": ">=22" }
}
